@import "colors.rasi"

configuration{
    modi: "drun";
    disable-history: false;
    hide-scrollbar: true;
    hover-select:				true;
	me-select-entry:			"";
	me-accept-entry:			"MousePrimary";
}

/*****----- Global Properties -----*****/
* {
	font: "Adwaita 13";
    background:     transparent;
    foreground:     @accent;
    selected:       @accent-selected;
   
}
element-text, element-icon {
    background-color: inherit;
    text-color:       inherit;

}

window {
    location: north;
    x-offset: 0px;
    y-offset: 45px;

    height: 440px;
    width: 700px;
    border: 0px;
    border-radius: 14px;
    background-color: @background-color;
}

mainbox {
    background-color: transparent;
          border:		5px 25px 5px 25px;
border-color: transparent;
}

inputbar {
    enabled:                     false;
    children: [prompt,entry];
    background-color: @background;
    border-radius: 10px;
    padding: 2px;
}

prompt {
    background-color: @selected;
    padding: 6px;
    text-color: Black;
    border-radius: 10px;
    margin: 20px 0px 0px 20px;
}

textbox-prompt-colon {
    expand: false;
    str: ":";
}

entry {
    padding: 6px;
    margin: 20px 0px 0px 10px;
    text-color: @foreground;
    background-color: @background;
    placeholder:"Search";

}

listview {
    padding: 15px 0px 0px 0px;
    columns: 1;
    background-color: @background;

}

element {
    padding: 5px 20px 5px 5px;
    background-color: @background;
    text-color: @foreground;


}

element-icon {
    size: 25px;   


}

element selected {
    text-color: @accent-text;
    border-radius: 5px;
        background-color: @selected;

}

mode-switcher {
    spacing: 0;
  }

button {
    padding: 10px;
    background-color: @background;
    text-color: black;
}

button selected {
  background-color: @background;
  text-color: @accent-text;

}
