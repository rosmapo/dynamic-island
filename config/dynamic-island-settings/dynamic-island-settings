    # ============================================================ navigácia
    def _on_tab_changed(self, stack, _pspec):
        name = stack.get_visible_child_name()
        if not name or name == '_search':
            return
        self.current_tab = name
        lb = self.tab_sidebars.get(name)
        if lb is None:
            return
        row = lb.get_selected_row()
        if row is None:
            row = lb.get_row_at_index(0)
            if row:
                lb.select_row(row)
        elif hasattr(row, 'sec'):
            self.show_section(name, row.sec, row.title)

    def _on_sidebar_selected(self, lb, row):
        if self._filling_sidebar or row is None or not hasattr(row, 'sec'):
            return
        self.search.set_text('')
        self.show_section(row.tab_id, row.sec, row.title)

    def show_section(self, tab_id, sec, title):
        self.current_tab = tab_id
        self.current_sec = sec
        stack = self.tab_stacks[tab_id]
        key = (tab_id, sec)
        name = f'{tab_id}:{sec}'
        if key not in self.pages:
            if sec == '__other__':
                page = self.build_other()
            elif sec in schema.ARRAYS:
                if sec == 'menu':
                    page = self.build_menu_master_detail()
                else:
                    page = self.build_array_page(sec)
            else:
                page = self.build_section(sec)
            self.pages[key] = page
            stack.add_named(page, name)
        stack.set_visible_child_name(name)
        self.content_stack.set_visible_child_name('tabs')
        if self.view_stack.get_visible_child_name() != tab_id:
            self.view_stack.set_visible_child_name(tab_id)

    def on_search(self, entry):
        q = entry.get_text().strip().lower()
        if not q:
            self.content_stack.set_visible_child_name('tabs')
            return
        # build results – samostatná vrstva, taby ostanú vo ViewSwitcher
        while self.search_page_holder.get_first_child():
            self.search_page_holder.remove(self.search_page_holder.get_first_child())
        page = Adw.PreferencesPage()
        grp = Adw.PreferencesGroup(title=f'Výsledky pre „{q}“')
        page.add(grp)
        n = 0
        titles = {sec: t for _g, sec, t in schema.sections_in_order()}
        sec_to_tab = {}
        for tid, _tl, _ti, sections in TABS:
            for sec, _title in sections:
                sec_to_tab[sec] = tid
        for (sec, key), e in self.model.schema.items():
            hay = f"{e['label']} {key} {sec} {e.get('desc', '')}".lower()
            if q in hay and e['type'] != 'modules':
                row = self.make_row(e, section_hint=titles.get(sec, sec))
                if row is not None:
                    go = Gtk.Button(icon_name='go-next-symbolic', valign=Gtk.Align.CENTER,
                                    tooltip_text='Prejsť na sekciu')
                    go.add_css_class('flat')
                    tid = sec_to_tab.get(sec, TABS[0][0])
                    title = titles.get(sec, sec)

                    def jump(_b, tid=tid, sec=sec, title=title):
                        self.search.set_text('')
                        self.content_stack.set_visible_child_name('tabs')
                        self.show_section(tid, sec, title)
                        lb = self.tab_sidebars.get(tid)
                        if lb:
                            r = lb.get_row_at_index(0)
                            while r:
                                if getattr(r, 'sec', None) == sec:
                                    lb.select_row(r)
                                    break
                                r = r.get_next_sibling()
                    go.connect('clicked', jump)
                    row.add_suffix(go)
                    grp.add(row)
                    n += 1
                if n >= 50:
                    break
        if n == 0:
            grp.set_description('Nič sa nenašlo.')
        self.search_page_holder.append(page)
        self.content_stack.set_visible_child_name('search')

    # ============================================================ stránky sekcií
    def build_section(self, sec):
        page = Adw.PreferencesPage()
        entries = [e for (s, k), e in self.model.schema.items() if s == sec]
        if sec == '':
            g = Adw.PreferencesGroup(title='Poradie modulov')
            self.build_modules(g, self.model.schema[('', 'modules')])
            page.add(g)
            return page
        basic = [e for e in entries if e['key'] not in ACTION_KEYS]
        actions = [e for e in entries if e['key'] in ACTION_KEYS]
        if basic:
            g = Adw.PreferencesGroup()
            for e in basic:
                r = self.make_row(e)
                if r is not None:
                    g.add(r)
            page.add(g)
        for ix in schema.INDEXED:
            if ix[0] == sec:
                page.add(self.build_indexed(ix))
        for m in schema.MAPS:
            if m[0] == sec:
                page.add(self.build_map(m))
        if actions:
            g = Adw.PreferencesGroup(
                title='Akcie a tooltip',
                description='Názov akcie (calendar, menu:meno, module:meno …) alebo ľubovoľný príkaz.')
            for e in actions:
                r = self.make_row(e)
                if r is not None:
                    g.add(r)
            page.add(g)
        return page

    def build_other(self):
        page = Adw.PreferencesPage()
        g = Adw.PreferencesGroup(
            title='Neznáme kľúče',
            description='GUI ich nepozná, ostanú v súbore nezmenené.')
        unk = self.model.unknown()
        if not unk:
            g.set_description('Žiadne – všetky kľúče v súbore GUI pozná.')
        for sec, key, val in unk:
            r = Adw.ActionRow(title=key, subtitle=f'[{sec}]  {short(val)}' if sec else short(val))
            g.add(r)
        page.add(g)
        return page

    # ============================================================ menu master–detail
    @staticmethod
    def rec_title(rec, aid, is_item=False):
        f = rec['fields']
        if is_item:
            if f.get('separator'):
                pos = {'top': ' (hore)', 'bottom': ' (dole)'}.get(f['separator'], '')
                return f'──── oddeľovač{pos} ────'
            if 'line' in f:
                return f'── riadok: {f["line"]}' if f['line'] else '── prázdny riadok ──'
            return (f.get('label') or f.get('icon') or f.get('command')
                    or f.get('exec') or f.get('track') or '(prázdna položka)')
        key = schema.ARRAYS[aid]['key']
        return f.get(key) or f.get('name') or f.get('exec') or f.get('on_click') or '(bez názvu)'

    def build_menu_master_detail(self):
        """Master–detail: vľavo zoznam menu, vpravo editor + položky."""
        a = schema.ARRAYS['menu']
        recs = self.model.get_array('menu')
        outer = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        outer.set_hexpand(True)
        outer.set_vexpand(True)

        # ---- left: menu list
        left_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        left_box.set_size_request(220, -1)
        left_head = Gtk.Label(label='Menu', xalign=0, margin_start=12, margin_top=12, margin_bottom=6)
        left_head.add_css_class('heading')
        left_box.append(left_head)

        menu_lb = Gtk.ListBox(selection_mode=Gtk.SelectionMode.SINGLE)
        menu_lb.add_css_class('navigation-sidebar')
        menu_scroll = Gtk.ScrolledWindow(child=menu_lb, vexpand=True,
                                         hscrollbar_policy=Gtk.PolicyType.NEVER)
        left_box.append(menu_scroll)

        add_menu_btn = Gtk.Button(label='Pridať menu', margin_start=8, margin_end=8,
                                  margin_top=8, margin_bottom=8)
        add_menu_btn.add_css_class('pill')
        left_box.append(add_menu_btn)
        outer.append(left_box)

        sep = Gtk.Separator(orientation=Gtk.Orientation.VERTICAL)
        outer.append(sep)

        # ---- right: detail
        right_scroll = Gtk.ScrolledWindow(hexpand=True, vexpand=True,
                                          hscrollbar_policy=Gtk.PolicyType.NEVER)
        right_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        right_scroll.set_child(right_box)
        outer.append(right_scroll)

        empty = Adw.StatusPage(
            icon_name='document-edit-symbolic',
            title='Vlastné menu',
            description=a['desc'] + '\n\nVyber menu vľavo alebo pridaj nové.')
        right_box.append(empty)

        detail_host = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        detail_host.set_visible(False)
        right_box.append(detail_host)

        state = {'selected': None}  # rec object

        def mark_dirty():
            self.value_changed()

        def rebuild_menu_list(select_rec=None):
            restore = _preserve_scroll(menu_scroll)
            while True:
                r = menu_lb.get_row_at_index(0)
                if r is None:
                    break
                menu_lb.remove(r)
            for i, rec in enumerate(recs):
                title = self.rec_title(rec, 'menu', False)
                n_items = len(rec.get('children') or [])
                row = Gtk.ListBoxRow()
                box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6,
                              margin_start=10, margin_end=6, margin_top=8, margin_bottom=8)
                lab = Gtk.Label(label=title, xalign=0, hexpand=True)
                lab.add_css_class('body')
                box.append(lab)
                badge = Gtk.Label(label=str(n_items))
                badge.add_css_class('dim-label')
                badge.add_css_class('caption')
                box.append(badge)
                # reorder + delete on the row
                up = Gtk.Button(icon_name='go-up-symbolic', sensitive=i > 0)
                dn = Gtk.Button(icon_name='go-down-symbolic', sensitive=i < len(recs) - 1)
                rm = Gtk.Button(icon_name='user-trash-symbolic')
                for b in (up, dn, rm):
                    b.add_css_class('flat')
                    b.set_valign(Gtk.Align.CENTER)
                    box.append(b)

                def do_up(_b, i=i):
                    recs.insert(i - 1, recs.pop(i))
                    mark_dirty()
                    rebuild_menu_list(recs[i - 1])

                def do_dn(_b, i=i):
                    recs.insert(i + 1, recs.pop(i))
                    mark_dirty()
                    rebuild_menu_list(recs[i + 1])

                def do_rm(_b, rec=rec):
                    if state['selected'] is rec:
                        state['selected'] = None
                    recs.remove(rec)
                    mark_dirty()
                    rebuild_menu_list()
                    show_detail(None)

                up.connect('clicked', do_up)
                dn.connect('clicked', do_dn)
                rm.connect('clicked', do_rm)
                row.set_child(box)
                row.rec = rec
                menu_lb.append(row)
                if select_rec is rec or (select_rec is None and state['selected'] is rec):
                    menu_lb.select_row(row)
            restore()
            if not recs:
                show_detail(None)

        def show_detail(rec):
            state['selected'] = rec
            # clear detail_host
            while True:
                c = detail_host.get_first_child()
                if c is None:
                    break
                detail_host.remove(c)
            if rec is None:
                empty.set_visible(True)
                detail_host.set_visible(False)
                return
            empty.set_visible(False)
            detail_host.set_visible(True)

            # menu fields
            fields_group = Adw.PreferencesGroup(title='Vlastnosti menu',
                                                description=f'[[menu]] · {self.rec_title(rec, "menu")}')
            detail_host.append(fields_group)

            def field_changed():
                mark_dirty()
                # len aktualizovať názov v ľavom zozname, nie celý rebuild (fokús v poli)
                row = menu_lb.get_selected_row()
                if row is not None and getattr(row, 'rec', None) is rec:
                    child = row.get_child()
                    if child is not None:
                        lab = child.get_first_child()
                        if isinstance(lab, Gtk.Label):
                            lab.set_text(self.rec_title(rec, 'menu', False))

            for spec in a['specs'].values():
                row = self.make_row(spec, binding=RecBinding(rec, spec, field_changed))
                if row is not None:
                    fields_group.add(row)

            # items
            items = rec.setdefault('children', [])
            items_group = Adw.PreferencesGroup(
                title='Položky',
                description='Poradie = poradie v paneli. Oddeľovač = vodorovná čiara.')
            detail_host.append(items_group)
            item_rows = []

            def rebuild_items():
                restore = _preserve_scroll(right_scroll)
                for r in item_rows:
                    items_group.remove(r)
                item_rows.clear()
                for i, it in enumerate(items):
                    title = self.rec_title(it, 'menu', True)
                    ex = Adw.ExpanderRow(title=GLib.markup_escape_text(title))
                    ex.set_expanded(False)

                    def item_changed(it=it, ex=ex):
                        ex.set_title(GLib.markup_escape_text(self.rec_title(it, 'menu', True)))
                        mark_dirty()

                    for spec in a['child'][1].values():
                        r = self.make_row(spec, binding=RecBinding(it, spec, item_changed))
                        if r is not None:
                            ex.add_row(r)
                    ctl = Gtk.Box(spacing=2, valign=Gtk.Align.CENTER)
                    for icon, fn, sens in (
                        ('go-up-symbolic',
                         lambda i=i: (items.insert(i - 1, items.pop(i)), mark_dirty(), rebuild_items()),
                         i > 0),
                        ('go-down-symbolic',
                         lambda i=i: (items.insert(i + 1, items.pop(i)), mark_dirty(), rebuild_items()),
                         i < len(items) - 1),
                        ('user-trash-symbolic',
                         lambda i=i: (items.pop(i), mark_dirty(), rebuild_items()),
                         True),
                    ):
                        b = Gtk.Button(icon_name=icon, sensitive=sens)
                        b.add_css_class('flat')
                        b.connect('clicked', lambda _b, fn=fn: fn())
                        ctl.append(b)
                    ex.add_suffix(ctl)
                    items_group.add(ex)
                    item_rows.append(ex)

                add = Adw.ActionRow(title='Pridať položku')
                ab = Gtk.Button(icon_name='list-add-symbolic', valign=Gtk.Align.CENTER)
                ab.add_css_class('flat')

                def add_item(_b):
                    new = {'src': None, 'fields': {}}
                    items.append(new)
                    mark_dirty()
                    rebuild_items()
                    # expand last
                    if item_rows:
                        item_rows[-1].set_expanded(True)

                ab.connect('clicked', add_item)
                add.add_suffix(ab)
                add.set_activatable_widget(ab)
                items_group.add(add)
                item_rows.append(add)
                restore()
                # badge = počet položiek v ľavom zozname
                row = menu_lb.get_selected_row()
                if row is not None and getattr(row, 'rec', None) is rec:
                    child = row.get_child()
                    if child is not None:
                        # lab, badge, up, dn, rm
                        badge = child.get_first_child()
                        if badge is not None:
                            badge = badge.get_next_sibling()
                        if isinstance(badge, Gtk.Label):
                            badge.set_text(str(len(items)))

