    # ============================================================ akcie
    def apply(self):
        try:
            backup = self.model.save()
        except Exception as ex:  # noqa: BLE001
            dlg = Adw.AlertDialog.new('Zápis zlyhal', str(ex))
            dlg.add_response('ok', 'Zavrieť')
            dlg.present(self)
            return
        self.reload(silent=True)
        msg = 'Uložené. Ostrovček sa reštartuje sám.'
        if backup:
            msg += f' Záloha: {os.path.basename(backup)}'
        self.toasts.add_toast(Adw.Toast.new(msg))

    def reload(self, silent=False):
        self.model.load()
        # drop cached pages
        for tid, stack in self.tab_stacks.items():
            for key, page in list(self.pages.items()):
                if key[0] == tid:
                    try:
                        stack.remove(page)
                    except Exception:  # noqa: BLE001
                        pass
        self.pages.clear()
        self.rows.clear()
        self.apply_btn.set_sensitive(False)
        # re-show current
        if self.current_tab and self.current_sec is not None:
            title = self.tab_titles.get(self.current_sec, self.current_sec)
            self.show_section(self.current_tab, self.current_sec, title)
        if not silent:
            self.toasts.add_toast(Adw.Toast.new('Súbor načítaný znova'))

    def discard(self):
        self.model.discard()
        self.reload(silent=True)
        self.toasts.add_toast(Adw.Toast.new('Zmeny zahodené'))

    def show_diff(self):
        old = self.model.text.splitlines(keepends=True)
        new = self.model.preview().splitlines(keepends=True)
        diff = ''.join(difflib.unified_diff(old, new, 'config.toml', 'po použití', n=1)) or 'Žiadne zmeny.'
        dlg = Adw.Dialog(title='Zmeny', content_width=720, content_height=520)
        tv = Gtk.TextView(editable=False, monospace=True, cursor_visible=False,
                          left_margin=12, top_margin=12)
        tv.get_buffer().set_text(diff)
        view = Adw.ToolbarView()
        view.add_top_bar(Adw.HeaderBar())
        view.set_content(Gtk.ScrolledWindow(child=tv))
        dlg.set_child(view)
        dlg.present(self)

    def on_close(self, *_a):
        if not self.model.dirty():
            return False
        dlg = Adw.AlertDialog.new('Neuložené zmeny', 'Máš zmeny, ktoré ešte neboli použité.')
        dlg.add_response('cancel', 'Zrušiť')
        dlg.add_response('discard', 'Zahodiť')
        dlg.add_response('save', 'Použiť a zavrieť')
        dlg.set_response_appearance('discard', Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_response_appearance('save', Adw.ResponseAppearance.SUGGESTED)
        dlg.set_default_response('save')

        def done(d, res):
            r = d.choose_finish(res)
            if r == 'save':
                self.apply()
                if not self.model.dirty():
                    self.destroy()
            elif r == 'discard':
                self.model.discard()
                self.destroy()
        dlg.choose(self, None, done)
        return True


class App(Adw.Application):
    def __init__(self, path):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.path = path

    def do_activate(self):
        win = self.props.active_window or Window(self, Model(self.path))
        win.present()


def main(argv):
    path = None
    if len(argv) > 2 and argv[1] in ('-c', '--config'):
        path = argv[2]
    elif len(argv) > 1 and not argv[1].startswith('-'):
        path = argv[1]
    return App(path).run([argv[0]])


if __name__ == '__main__':
    sys.exit(main(sys.argv))
