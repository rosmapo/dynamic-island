    # ============================================================ ostatné polia tabuliek (custom, rules)
    def build_array_page(self, aid):
        a = schema.ARRAYS[aid]
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(title=a['title'], description=a['desc'])
        page.add(group)
        recs = self.model.get_array(aid)
        state = {}
        rows = []

        def structure_changed():
            self.value_changed()
            rebuild()

        def make_expander(rec, specs, siblings, is_item):
            ex = Adw.ExpanderRow(title=GLib.markup_escape_text(self.rec_title(rec, aid, is_item)))
            ex.set_expanded(state.get(id(rec), False))
            ex.connect('notify::expanded', lambda r, _p: state.__setitem__(id(rec), r.get_expanded()))

            def changed():
                ex.set_title(GLib.markup_escape_text(self.rec_title(rec, aid, is_item)))
                self.value_changed()

            for spec in specs.values():
                r = self.make_row(spec, binding=RecBinding(rec, spec, changed))
                if r is not None:
                    ex.add_row(r)
            ctl = Gtk.Box(spacing=2, valign=Gtk.Align.CENTER)
            i = siblings.index(rec)

            def move(d):
                j = i + d
                if 0 <= j < len(siblings):
                    siblings.insert(j, siblings.pop(i))
                    structure_changed()

            for icon, fn, sens in (
                ('go-up-symbolic', lambda: move(-1), i > 0),
                ('go-down-symbolic', lambda: move(1), i < len(siblings) - 1),
                ('user-trash-symbolic', lambda: (siblings.remove(rec), structure_changed()), True),
            ):
                b = Gtk.Button(icon_name=icon, sensitive=sens)
                b.add_css_class('flat')
                b.connect('clicked', lambda _b, fn=fn: fn())
                ctl.append(b)
            ex.add_suffix(ctl)
            return ex

        def rebuild():
            restore = _preserve_scroll(page)
            for r in rows:
                group.remove(r)
            rows.clear()
            for rec in recs:
                ex = make_expander(rec, a['specs'], recs, False)
                group.add(ex)
                rows.append(ex)
            add = Adw.ActionRow(title=a['add'])
            ab = Gtk.Button(icon_name='list-add-symbolic', valign=Gtk.Align.CENTER)
            ab.add_css_class('flat')

            def add_rec(_b):
                new = {'src': None, 'fields': {}}
                if a['child']:
                    new['children'] = []
                recs.append(new)
                state[id(new)] = True
                structure_changed()

            ab.connect('clicked', add_rec)
            add.add_suffix(ab)
            add.set_activatable_widget(ab)
            group.add(add)
            rows.append(add)
            restore()

        rebuild()
        return page

    # ============================================================ riadky
    def value_changed(self):
        self.apply_btn.set_sensitive(self.model.dirty())
        self.refresh_resets()

    def refresh_resets(self):
        for b, btn in self.rows:
            btn.set_visible(not b.is_default())

    def reset_button(self, b, e, on_reset):
        btn = Gtk.Button(icon_name='edit-undo-symbolic', valign=Gtk.Align.CENTER,
                         tooltip_text=self.default_tooltip(e))
        btn.add_css_class('flat')
        btn.set_visible(not b.is_default())

        def clicked(_b):
            b.reset()
            on_reset()
            self.value_changed()
        btn.connect('clicked', clicked)
        self.rows.append((b, btn))
        return btn

    @staticmethod
    def default_tooltip(e):
        d = e.get('default')
        if isinstance(d, bool):
            d = 'zapnuté' if d else 'vypnuté'
        elif isinstance(d, list):
            d = ', '.join(str(x) for x in d)
        elif d in (None, ''):
            d = 'nenastavené'
        return f'Vrátiť predvolenú hodnotu: {d}'

    def subtitle(self, e, section_hint=None):
        parts = []
        if e.get('desc'):
            parts.append(e['desc'])
        sec = e.get('section', '')
        where = f"{sec}.{e['key']}" if sec else e['key']
        parts.append((f'{section_hint} · ' if section_hint else '') + where)
        return GLib.markup_escape_text('\n'.join(parts))

    def make_row(self, e, section_hint=None, binding=None):
        t = e['type']
        sec, key = e.get('section', ''), e['key']
        m = binding or ModelBinding(self.model, sec, key)
        val = m.get()
        title = GLib.markup_escape_text(e['label'])
        sub = self.subtitle(e, section_hint)

        if t == 'bool':
            row = Adw.SwitchRow(title=title, subtitle=sub)
            row.set_active(bool(val))
            row.connect('notify::active', lambda r, _p: (m.set(r.get_active()), self.value_changed()))
            row.add_suffix(self.reset_button(m, e, lambda: row.set_active(bool(m.get()))))
            return row

        if t in ('int', 'float'):
            lo = e['min'] if e.get('min') is not None else 0.0
            hi = e['max'] if e.get('max') is not None else 1000000.0
            digits = 0 if t == 'int' else 2
            step = 1.0 if t == 'int' else 0.05
            nullable = e.get('nullable')
            cur = 0 if val is None else val
            adj = Gtk.Adjustment(value=float(cur), lower=0.0 if nullable else float(lo),
                                 upper=float(hi), step_increment=step, page_increment=step * 10)
            row = Adw.SpinRow(title=title, subtitle=sub, adjustment=adj, digits=digits)
            suppress = [False]

            def changed(r, _p):
                if suppress[0]:
                    return
                v = r.get_value()
                if nullable and v < 1:
                    m.reset()
                else:
                    m.set(int(round(v)) if t == 'int' else round(v, 3))
                self.value_changed()
            row.connect('notify::value', changed)

            def reset_ui():
                suppress[0] = True
                d = m.get()
                row.set_value(float(d) if d is not None else 0.0)
                suppress[0] = False
            row.add_suffix(self.reset_button(m, e, reset_ui))
            return row

        if t == 'enum':
            choices = e['choices']
            labels = e.get('choice_labels') or {}
            if val is True:        # staré `separator = true` = čiara v strede
                val = 'center'
            elif val is False:
                val = ''
            row = Adw.ComboRow(title=title, subtitle=sub,
                               model=Gtk.StringList.new([labels.get(c, c) for c in choices]))
            row.set_selected(choices.index(val) if val in choices else 0)
            suppress = [False]

            def changed(r, _p):
                if not suppress[0]:
                    m.set(choices[r.get_selected()])
                    self.value_changed()
            row.connect('notify::selected', changed)

            def reset_ui():
                suppress[0] = True
                d = m.get()
                row.set_selected(choices.index(d) if d in choices else 0)
                suppress[0] = False
            row.add_suffix(self.reset_button(m, e, reset_ui))
            return row

        row = Adw.ActionRow(title=title, subtitle=sub)
        entry = Gtk.Entry(valign=Gtk.Align.CENTER, width_chars=28, max_width_chars=42, hexpand=True)
        entry.set_alignment(0.0)
        multiline = t in ('str', 'command')

        def show(v):
            if t in ('strlist', 'numlist'):
                return ', '.join(str(x) for x in (v or []))
            s_ = '' if v is None else str(v)
            return s_.replace('\n', '\\n') if multiline else s_

        def parse(s_):
            if t == 'strlist':
                return [x.strip() for x in s_.split(',') if x.strip()]
            if t == 'numlist':
                out = []
                for x in s_.split(','):
                    x = x.strip()
                    if x:
                        try:
                            out.append(int(x, 0))
                        except ValueError:
                            pass
                return out
            return s_.replace('\\n', '\n') if multiline else s_

        entry.set_text(show(val))
        suppress = [False]

        def changed(r):
            if suppress[0]:
                return
            v = parse(r.get_text())
            if t == 'color' and v == '':
                m.reset()
            else:
                m.set(v)
            self.value_changed()
        entry.connect('changed', changed)

        def reset_ui():
            suppress[0] = True
            entry.set_text(show(m.get()))
            suppress[0] = False
        row.add_suffix(entry)
        if t == 'path':
            b = Gtk.Button(icon_name='document-open-symbolic', valign=Gtk.Align.CENTER,
                           tooltip_text='Vybrať…')
            b.add_css_class('flat')
            folder = key.endswith('dir') or key.endswith('directory')
            b.connect('clicked', lambda _b: self.choose_path(entry, folder))
            row.add_suffix(b)
        if t == 'icon' or e.get('icon_list'):
            lab = Gtk.Label(valign=Gtk.Align.CENTER)
            lab.set_attributes(Pango.AttrList.from_string(f'0 -1 font-desc "{self.icon_font} 16"'))
            lab.set_text(entry.get_text().replace(',', ' '))
            entry.connect('changed', lambda r: lab.set_text(r.get_text().replace(',', ' ')))
            row.add_suffix(lab)
        if t == 'color':
            cb = Gtk.ColorDialogButton(dialog=Gtk.ColorDialog(), valign=Gtk.Align.CENTER)
            rgba = Gdk.RGBA()
            if (val or '').startswith('#') and rgba.parse(val):
                cb.set_rgba(rgba)

            def picked(btn, _p):
                c = btn.get_rgba()
                hexs = '#%02x%02x%02x' % (round(c.red * 255), round(c.green * 255), round(c.blue * 255))
                if c.alpha < 0.999:
                    hexs += '%02x' % round(c.alpha * 255)
                if entry.get_text() != hexs:
                    entry.set_text(hexs)
            cb.connect('notify::rgba', picked)
            row.add_suffix(cb)
        row.add_suffix(self.reset_button(m, e, reset_ui))
        return row

    def choose_path(self, entry, folder):
        dlg = Gtk.FileDialog()

        def done(d, res):
            try:
                f = d.select_folder_finish(res) if folder else d.open_finish(res)
            except GLib.Error:
                return
            if f is not None:
                p = f.get_path()
                home = os.path.expanduser('~')
                if p.startswith(home):
                    p = '~' + p[len(home):]
                entry.set_text(p)
        (dlg.select_folder if folder else dlg.open)(self, None, done)

    # ============================================================ zoznam modulov
    def build_modules(self, group, e):
        m = self.model
        names = list(m.value('', 'modules') or [])
        box_rows = []

        def commit():
            m.set('', 'modules', list(names))
            self.value_changed()

        def rebuild():
            restore = _preserve_scroll(group)
            for r in box_rows:
                group.remove(r)
            box_rows.clear()
            for i, n in enumerate(names):
                row = Adw.ActionRow(title=GLib.markup_escape_text(n))
                up = Gtk.Button(icon_name='go-up-symbolic', valign=Gtk.Align.CENTER, sensitive=i > 0)
                dn = Gtk.Button(icon_name='go-down-symbolic', valign=Gtk.Align.CENTER,
                                sensitive=i < len(names) - 1)
                rm = Gtk.Button(icon_name='user-trash-symbolic', valign=Gtk.Align.CENTER)
                for b in (up, dn, rm):
                    b.add_css_class('flat')
                    row.add_suffix(b)
                up.connect('clicked', lambda _b, i=i: (names.insert(i - 1, names.pop(i)), commit(), rebuild()))
                dn.connect('clicked', lambda _b, i=i: (names.insert(i + 1, names.pop(i)), commit(), rebuild()))
                rm.connect('clicked', lambda _b, i=i: (names.pop(i), commit(), rebuild()))
                group.add(row)
                box_rows.append(row)
            add = Adw.EntryRow(title='Pridať modul (vstavaný názov alebo vlastný z [[custom]])')
            add.set_show_apply_button(True)
            add.connect('apply', lambda r: (
                names.append(r.get_text().strip()) if r.get_text().strip() else None,
                commit(), rebuild()))
            group.add(add)
            box_rows.append(add)
            restore()
        rebuild()
        group.set_description('Vstavané: ' + ', '.join(MODULE_CHOICES))
        reset = Gtk.Button(label='Predvolené', valign=Gtk.Align.CENTER)
        reset.connect('clicked', lambda _b: (
            names.__setitem__(slice(None), list(e['default'])), commit(), rebuild()))
        group.set_header_suffix(reset)

    # ============================================================ indexované / mapy
    def build_indexed(self, ix):
        sec, name, pats, maxn, hint = ix
        m = self.model
        group = Adw.PreferencesGroup(title=name, description=hint)
        items = [dict(x) for x in m.get_indexed(sec, name, pats, maxn)]
        rows = []

        def commit():
            m.set_indexed(sec, name, [dict(x) for x in items])
            self.value_changed()

        def rebuild():
            restore = _preserve_scroll(group)
            for r in rows:
                group.remove(r)
            rows.clear()
            for i, it in enumerate(items):
                first = str(it.get(pats[0][0], '')) or '(prázdne)'
                ex = Adw.ExpanderRow(title=GLib.markup_escape_text(f'{i + 1}. {first}'))
                for p, label, typ in pats:
                    er = Adw.EntryRow(title=label)
                    er.set_text(str(it.get(p, '')))
                    er.connect('changed', lambda r, p=p, it=it: (it.__setitem__(p, r.get_text()), commit()))
                    ex.add_row(er)
                ctl = Gtk.Box(spacing=2, valign=Gtk.Align.CENTER)
                for icon, fn, sens in (
                    ('go-up-symbolic',
                     lambda i=i: (items.insert(i - 1, items.pop(i)), commit(), rebuild()), i > 0),
                    ('go-down-symbolic',
                     lambda i=i: (items.insert(i + 1, items.pop(i)), commit(), rebuild()),
                     i < len(items) - 1),
                    ('user-trash-symbolic',
                     lambda i=i: (items.pop(i), commit(), rebuild()), True),
                ):
                    b = Gtk.Button(icon_name=icon, sensitive=sens)
                    b.add_css_class('flat')
                    b.connect('clicked', lambda _b, fn=fn: fn())
                    ctl.append(b)
                ex.add_suffix(ctl)
                group.add(ex)
                rows.append(ex)
            if len(items) < maxn:
                add = Adw.ActionRow(title='Pridať')
                b = Gtk.Button(icon_name='list-add-symbolic', valign=Gtk.Align.CENTER)
                b.add_css_class('flat')
                b.connect('clicked', lambda _b: (
