def short(v):
    s = repr(v) if not isinstance(v, str) else v
    return s if len(s) < 60 else s[:57] + '…'


def _find_scrolled(widget):
    w = widget
    while w is not None:
        if isinstance(w, Gtk.ScrolledWindow):
            return w
        w = w.get_parent()

    def down(w):
        if isinstance(w, Gtk.ScrolledWindow):
            return w
        child = w.get_first_child()
        while child is not None:
            found = down(child)
            if found is not None:
                return found
            child = child.get_next_sibling()
        return None
    return down(widget)


def _preserve_scroll(anchor):
    sw = _find_scrolled(anchor)
    if sw is None:
        return lambda: None
    vadj = sw.get_vadjustment()
    val = vadj.get_value()

    def restore():
        def _do():
            upper = vadj.get_upper() - vadj.get_page_size()
            vadj.set_value(min(val, max(0.0, upper)))
            return False
        GLib.idle_add(_do)
    return restore


class ModelBinding:
    def __init__(self, model, sec, key):
        self.m, self.sec, self.key = model, sec, key

    def get(self):
        return self.m.value(self.sec, self.key)

    def set(self, v):
        self.m.set(self.sec, self.key, v)

    def reset(self):
        self.m.reset(self.sec, self.key)

    def is_default(self):
        return self.m.is_default(self.sec, self.key)


class RecBinding:
    def __init__(self, rec, spec, changed):
        self.rec, self.spec, self.changed = rec, spec, changed

    def get(self):
        f = self.rec['fields']
        return f[self.spec['key']] if self.spec['key'] in f else self.spec.get('default')

    def set(self, v):
        key = self.spec['key']
        if self.spec.get('nullable') and (v is None or v < 1):
            self.rec['fields'].pop(key, None)
        else:
            self.rec['fields'][key] = v
        self.changed()

    def reset(self):
        self.rec['fields'].pop(self.spec['key'], None)
        self.changed()

    def is_default(self):
        return self.spec['key'] not in self.rec['fields']


